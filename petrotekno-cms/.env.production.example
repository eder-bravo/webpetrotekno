# ===========================================
# CONFIGURACIÓN DE PRODUCCIÓN - DOKPLOY
# ===========================================
# 
# Copia este archivo y configúralo en Dokploy como variables de entorno
# NO incluyas este archivo en tu repositorio con valores reales
#

# ===========================================
# APLICACIÓN
# ===========================================
APP_NAME="Petrotekno CMS"
APP_ENV=production
APP_KEY=base64:TU_KEY_GENERADO_AQUI
APP_DEBUG=false
APP_URL=https://tu-dominio-backend.com
# Código inicial único de al menos 12 caracteres; cambiarlo desde el panel después de iniciar.
PANEL_ACCESS_CODE=

# Localización
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

# ===========================================
# BASE DE DATOS - SQLite
# ===========================================
DB_CONNECTION=sqlite
# No necesitas más configuración para SQLite

# ===========================================
# SESIONES Y CACHÉ
# ===========================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# ===========================================
# LOGGING
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===========================================
# CORREO (Configura según tu proveedor)
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@petrotekno.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# SEGURIDAD
# ===========================================
BCRYPT_ROUNDS=12

# ===========================================
# CORS (Si necesitas configurar CORS)
# ===========================================
# SANCTUM_STATEFUL_DOMAINS=tu-dominio-frontend.com
# SESSION_DOMAIN=.tu-dominio.com
