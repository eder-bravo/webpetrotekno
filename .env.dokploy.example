# ==========================================
# Variables de Entorno para Dokploy
# ==========================================
# 
# Copia este archivo en Dokploy como variables de entorno
# o configúralas directamente en el panel

# Backend Laravel
APP_NAME=Petrotekno CMS
APP_KEY=base64:GENERA_UNA_KEY_NUEVA_CON_php_artisan_key_generate

# URLs de tu dominio
BACKEND_URL=https://cms.tu-dominio.com
BACKEND_DOMAIN=cms.tu-dominio.com
FRONTEND_DOMAIN=tu-dominio.com
FRONTEND_DOMAIN_WWW=www.tu-dominio.com
